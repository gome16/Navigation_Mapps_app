<h1>ユーザー一覧</h1>

<div class="col-md-12 mt-2">
  <div class="card">        
    <div class="card-body">
      <table class="table table-m custom-post-table">
        <thead>
          <tr>
            <th>ID</th>
            <th>ユーザー名</th>
            <th>メールアドレス</th>
            <th>ステータス</th>
            <th>操作</th>
          </tr>
        </thead>

        <tbody>
          <% @users.each do |user| %>
            <tr class="post-row border-bottom" data-href="<%= user_path(user) %>">
              <td><%= user.id %></td>
              <td>
                <%= link_to user_path(user), class: "d-flex align-items-center text-decoration-none text-dark" do %>
                  <div class="me-2">
                    <%= image_tag user.get_profile_image(100, 100),class: "rounded-circle",style: "width:40px; height:40px; object-fit:cover;" %>
                  </div>
                  <%= user.user_name %>
                <% end %>
              </td>

              <td><%= user.email %></td>
              <td>
                <% if user.is_deleted %>
                  <span class="badge bg-secondary">無効</span>
                <% else %>
                  <span class="badge bg-success">有効</span>
                <% end %>
              </td>

              <td>
                <%= button_to(
                      user.is_deleted ? "有効" : "無効",
                      toggle_deleted_admin_user_path(user),
                      method: :patch,
                      class: user.is_deleted ? "btn btn-sm btn-success" : "btn btn-sm btn-danger",
                      data: { confirm: "本当に切り替えますか？" }
                    ) %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>

      <%= paginate @users %>
    </div>
  </div>
</div>
