<h1>ユーザー一覧</h1>

<div class="col-md-12 mt-2">
  <div class="card">        
    <div class="card-body">
      <table class="table table-m custom-post-table">
        <thead>
          <tr>
            <th>ID</th>
            <th>ユーザー名</th>
            <th>メールアドレス</th>
          </tr>
        </thead>

        <tbody>
          <% @users.each do |user| %>
            <tr class="post-row border-bottom" data-href="<%= user_path(user) %>">

              <td><%= user.id %></td>

              <td>
                <%= link_to user_path(user), class: "d-flex align-items-center text-decoration-none text-dark" do %>
                  <div class="me-2">
                    <%= image_tag user.get_profile_image(100, 100),
                          class: "rounded-circle",
                          style: "width:40px; height:40px; object-fit:cover;" %>
                  </div>
                  <%= user.user_name %>
                <% end %>
              </td>

              <td><%= user.email %></td>
            </tr>
          <% end %>
        </tbody>
      </table>

      <%= paginate @users %>
    </div>
  </div>
</div>
